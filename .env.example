# Secret access code ("Magic Number") required on the login page
MAGIC_CODE=1120

# Leave blank to allow any Matric Number for now.
# Once you have Hillary's exact Matric Number, set it here (e.g. ALLOWED_MATRIC=CSC/2026/042)
ALLOWED_MATRIC=

# Candidate full name & short name displayed across the platform
STUDENT_FULL_NAME=Olawuyi Eniola Hilary
STUDENT_FIRST_NAME=Hilary

# Branding shown on the Welcome, Login, and Result pages
POWERED_BY_NAME=SAMUELL

# Secret key for signing login sessions
SECRET_KEY=hillary-cbt-super-secret-key-2026-samuell

# Database URL:
# Defaults to local SQLite (sqlite:///./cbt_exam.db) when not set.
# For Render + Neon free hosting, paste your Neon PostgreSQL connection string here:
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./cbt_exam.db
